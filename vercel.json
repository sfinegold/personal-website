{
  "rewrites": [
    {
      "source": "/charlottes-grand-adventure",
      "destination": "/api/charlotte"
    },
    {
      "source": "/charlottes-grand-adventure/",
      "destination": "/api/charlotte"
    },
    {
      "source": "/charlottes-grand-adventure/:path*",
      "destination": "/api/charlotte"
    },
    {
      "source": "/milton-finance-review",
      "destination": "/api/milton-finance-review"
    },
    {
      "source": "/lineup/milton",
      "destination": "/api/lineup-milton"
    },
    {
      "source": "/lineup/me",
      "destination": "/api/lineup-me"
    },
    {
      "source": "/lineup/map",
      "destination": "/api/lineup-map"
    },
    {
      "source": "/lineup/sf",
      "destination": "/api/lineup-listen"
    },
    {
      "source": "/lineup/auth",
      "destination": "/api/lineup-auth"
    },
    {
      "source": "/lineup/venue/:id",
      "destination": "/api/lineup-venue?id=:id"
    },
    {
      "source": "/lineup/yt",
      "destination": "/api/lineup-yt"
    }
  ],
  "functions": {
    "api/lineup-milton.js": {
      "maxDuration": 60
    },
    "api/lineup-me.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/music-learning/curriculum.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/music-learning/feedback.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
